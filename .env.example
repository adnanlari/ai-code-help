# --- Supabase Postgres (Session pooler or direct connection string) ---
# Get this from: Supabase dashboard -> Project Settings -> Database -> Connection string
# Use the URI form. asyncpg does NOT understand the "?pgbouncer=true" query param or
# the "postgresql+asyncpg://" SQLAlchemy prefix - use a plain "postgresql://" URI.
DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres

# --- Voyage AI (embeddings) ---
# https://dashboard.voyageai.com/ -> API Keys
VOYAGE_API_KEY=

# --- Anthropic (unused until Day 2) ---
ANTHROPIC_API_KEY=

# --- Local scratch space for git clones (deleted after each repo is embedded) ---
WORKDIR=./workdir

# --- Chunking knobs (line-window chunker) ---
CHUNK_LINES=60
CHUNK_OVERLAP_LINES=15

# --- Embedding model ---
EMBED_MODEL=voyage-code-3
EMBED_DIM=1024

# Client-side throttle to match your Voyage account limits (avoids RateLimitError).
# 0 = no throttle. If you have NOT added a payment method at dashboard.voyageai.com,
# your limits are 3 RPM / 10000 TPM — set these to index without erroring (slowly):
#   EMBED_RPM=3
#   EMBED_TPM=10000
EMBED_RPM=0
EMBED_TPM=0

# --- Retrieval default ---
TOP_K=5
